// Code signing. Default: ad-hoc ("Sign to Run Locally") — works anywhere, but every build is a new identity to
// macOS, so folder access (security-scoped bookmarks) and privacy permissions are asked for again after each build.
//
// For a stable identity, create Config/Signing.local.xcconfig (git-ignored) — `scripts/setup-signing.sh` does it
// once an "Apple Development" certificate exists (Xcode ▸ Settings ▸ Accounts ▸ add your Apple ID, free).
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
